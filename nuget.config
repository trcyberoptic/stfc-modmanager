<?xml version="1.0" encoding="utf-8"?>
<!--
  Projekt-lokale NuGet-Quelle. Das globale NuGet.Config auf diesem Rechner
  (%APPDATA%\NuGet\NuGet.Config) hat bewusst KEINE Paketquellen konfiguriert.
  Dieses Projekt referenziert selbst keine NuGet-Pakete (BCL only), aber der
  .NET-SDK-Build für SelfContained+PublishSingleFile/win-x64 muss die
  Runtime-Packs (Microsoft.NETCore.App.Runtime.win-x64 usw.) und
  Microsoft.NET.ILLink.Tasks implizit aus nuget.org auflösen. Ohne Quelle
  scheitert "dotnet build" mit NU1100. Diese Datei ist repo-lokal und
  überschreibt keine globale Konfiguration.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
